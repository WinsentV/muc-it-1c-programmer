
Процедура ОбработкаПроведения(Отказ, Режим)

	
	Движения.Продажи.Записывать = Истина;
	Движения.Взаиморасчеты.Записывать = Истина;
	
	ОбщаяСуммаДокумента = 0;
	
	
	Для Каждого ТекСтрокаТовары Из Товары Цикл
		Движение = Движения.Продажи.Добавить();
		Движение.Период = Дата;
		Движение.Контрагент = Контрагент;
		Движение.Номенклатура = ТекСтрокаТовары.Номенклатура;
		Движение.Количество = ТекСтрокаТовары.Количество;
		Движение.Сумма = ТекСтрокаТовары.Сумма;
		
		ОбщаяСуммаДокумента = ОбщаяСуммаДокумента + ТекСтрокаТовары.Сумма;
	КонецЦикла;
	
	
	Если ОбщаяСуммаДокумента > 0 Тогда
		ДвижениеВзаиморасчеты = Движения.Взаиморасчеты.Добавить();
		ДвижениеВзаиморасчеты.ВидДвижения = ВидДвиженияНакопления.Приход;
		ДвижениеВзаиморасчеты.Период = Дата;
		ДвижениеВзаиморасчеты.Контрагент = Контрагент;
		ДвижениеВзаиморасчеты.СуммаДолга = ОбщаяСуммаДокумента;
	КонецЕсли;
КонецПроцедуры
