
&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	СтрокаТЧТовары = Элементы.Товары.ТекущиеДанные;
	СтрокаТЧТовары.Сумма = СтрокаТЧТовары.Количество * СтрокаТЧТовары.Цена;
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)
	СтрокаТЧТовары = Элементы.Товары.ТекущиеДанные;
	СтрокаТЧТовары.Сумма = СтрокаТЧТовары.Количество * СтрокаТЧТовары.Цена;
КонецПроцедуры

&НаКлиенте
Процедура ТоварыСуммаПриИзменении(Элемент)
	СтрокаТЧТовары = Элементы.Товары.ТекущиеДанные;
	Если (СтрокаТЧТовары <> Неопределено и СтрокаТЧТовары.Количество = 0) Тогда
		СтрокаТЧТовары.Цена = 0;
	Иначе
		СтрокаТЧТовары.Цена = СтрокаТЧТовары.Сумма / СтрокаТЧТовары.Количество;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Константы.ВалютаУчета.Получить() <> Неопределено  Тогда
		Объект.ВалютаДокумента = Константы.ВалютаУчета.Получить();
	КонецЕсли;
	
	АвтоЗаголовок = Ложь;
	Заголовок = "Продажа товаров от лица: " + Константы.НазваниеОрганизации.Получить();
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	СтрокаТЧТовары = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТЧТовары = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТЧТовары.Цена = ПолучитьАктуальнуюЦену(Объект.Дата, СтрокаТЧТовары.Номенклатура);
	
	СтрокаТЧТовары.Сумма = СтрокаТЧТовары.Количество * СтрокаТЧТовары.Цена;	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьАктуальнуюЦену(ДатаДокумента, Номенклатура)
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат 0;
	КонецЕсли;

	Отбор = Новый Структура("Номенклатура", Номенклатура);
	
	ДатаСреза = ?(ЗначениеЗаполнено(ДатаДокумента), ДатаДокумента, ТекущаяДатаСеанса());
	
	Ресурсы = РегистрыСведений.ЦеныНоменклатуры.ПолучитьПоследнее(ДатаСреза, Отбор);
	
	Возврат Ресурсы.Цена;
КонецФункции

&НаСервере
Функция ПечатьАктаОказанияУслугНаСервере()
	ТабличныйДокумент = новый ТабличныйДокумент;
	МакетАктОказанияУслуг = Документы.РеализацияТоваровУслуг.ПолучитьМакет("АктОказанияУслуг");
	
	ОбластьШапка = МакетАктОказанияУслуг.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Номер = Объект.Номер;
	ОбластьШапка.Параметры.Дата = Объект.Дата;
	ОбластьШапка.Параметры.НазваниеОрганизации = Константы.НазваниеОрганизации.Получить();
	ОбластьШапка.Параметры.Контрагент = Объект.Контрагент;
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ОбластьШапкаТаблицы = МакетАктОказанияУслуг.ПолучитьОбласть("ШапкаТаблицы");
	ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
	
	ОбластьТаблица = МакетАктОказанияУслуг.ПолучитьОбласть("Таблица");
	СуммаИтого = 0;
	Для Каждого СтрокаТЧ из Объект.Товары Цикл
		ОбластьТаблица.Параметры.НомерСтроки = СтрокаТЧ.НомерСтроки;
		ОбластьТаблица.Параметры.Номенклатура = СтрокаТЧ.Номенклатура;
		ОбластьТаблица.Параметры.Количество = СтрокаТЧ.Количество;
		ОбластьТаблица.Параметры.Цена = СтрокаТЧ.Цена;
		ОбластьТаблица.Параметры.Сумма = СтрокаТЧ.Сумма;
		ТабличныйДокумент.Вывести(ОбластьТаблица);
		СуммаИтого = СуммаИтого + СтрокаТЧ.Сумма; 
	КонецЦикла;
	
	ОбластьПодвал = МакетАктОказанияУслуг.ПолучитьОбласть("Подвал");
	ОбластьПодвал.Параметры.СуммаИтого = ЧислоПрописью(СуммаИтого,
			"Л=ru_RU; ДП=Истина",
			"рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2");
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	
	Возврат ТабличныйДокумент;
КонецФункции

&НаКлиенте
Процедура ПечатьАктаОказанияУслуг(Команда)
	ТабДок = ПечатьАктаОказанияУслугНаСервере();
	ТабДок.Показать("Документ реализация товаров и услуг");
КонецПроцедуры


